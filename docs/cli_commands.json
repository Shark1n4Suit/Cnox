{
  "name": "coelanox",
  "version": "0.6.0-beta",
  "description": "COELANOX - Secure AI Container",
  "global_options": [
    { "long": "--help", "short": "-h", "type": "flag", "description": "Print help" },
    { "long": "--version", "short": "-V", "type": "flag", "description": "Print version" }
  ],
  "commands": [
    {
      "id": "package",
      "name": "package",
      "description": "Package a model into a COELANOX container",
      "usage": "coelanox package [OPTIONS] --input <INPUT> --output <OUTPUT>",
      "required": [
        { "long": "--input", "short": "-i", "type": "string", "placeholder": "INPUT", "description": "Input model file" },
        { "long": "--output", "short": "-o", "type": "string", "placeholder": "OUTPUT", "description": "Output COELANOX file" }
      ],
      "optional": [
        { "long": "--model-type", "short": "-m", "type": "string", "default": "cv", "description": "Model type (cv, nlp, audio, tabular, custom)", "choices": ["cv", "nlp", "audio", "tabular", "custom"] },
        { "long": "--input-shapes", "type": "string", "description": "Input shapes for custom models, e.g. [1,3,224,224]" },
        { "long": "--output-shapes", "type": "string", "description": "Output shapes for custom models" },
        { "long": "--target", "short": "-t", "type": "string", "default": "auto", "description": "Target hardware (cpu, gpu, edge, auto, h100, a100, etc.)" },
        { "long": "--optimization", "type": "string", "default": "advanced", "description": "Optimization level", "choices": ["none", "basic", "advanced", "maximum"] },
        { "long": "--use-demo-translator", "type": "flag", "description": "Use demo/custom translator (e.g. BERT for NLP)" },
        { "long": "--fat", "type": "flag", "description": "Include all available backends (mutually exclusive with --target/--auto)" },
        { "long": "--auto", "type": "flag", "description": "Auto-detect hardware (mutually exclusive with --target/--fat)" },
        { "long": "--backend-add", "type": "string", "description": "Add backends, comma-separated (amd,intel,qualcomm)" },
        { "long": "--fallback-only", "type": "flag", "description": "No backend code; scalar fallback only (benchmarking)" },
        { "long": "--max-workspace", "type": "string", "description": "Max workspace+scratch in MB (e.g. 64, 1024)" }
      ]
    },
    {
      "id": "validate",
      "name": "validate",
      "description": "Validate a COELANOX container",
      "usage": "coelanox validate --file <FILE>",
      "required": [
        { "long": "--file", "short": "-f", "type": "string", "placeholder": "FILE", "description": "COELANOX file to validate" }
      ],
      "optional": []
    },
    {
      "id": "verify",
      "name": "verify",
      "description": "Verify container integrity (pre-deployment check)",
      "usage": "coelanox verify [OPTIONS] --file <FILE>",
      "required": [
        { "long": "--file", "short": "-f", "type": "string", "placeholder": "FILE", "description": "COELANOX file to verify" }
      ],
      "optional": [
        { "long": "--verbose", "short": "-v", "type": "flag", "description": "Verbose output" }
      ]
    },
    {
      "id": "info",
      "name": "info",
      "description": "Show information about a COELANOX container",
      "usage": "coelanox info [OPTIONS] --file <FILE>",
      "required": [
        { "long": "--file", "short": "-f", "type": "string", "placeholder": "FILE", "description": "COELANOX file to inspect" }
      ],
      "optional": [
        { "long": "--dump-plan", "type": "flag", "description": "Dump execution plan steps (step_ix, in_len, out_len, w_len, scratch_raw)" }
      ]
    },
    {
      "id": "run",
      "name": "run",
      "description": "Run inference on a COELANOX container",
      "usage": "coelanox run [OPTIONS] --file <FILE> --output <OUTPUT>",
      "required": [
        { "long": "--file", "short": "-f", "type": "string", "placeholder": "FILE", "description": "COELANOX file to run" },
        { "long": "--output", "short": "-o", "type": "string", "placeholder": "OUTPUT", "description": "Output file" }
      ],
      "optional": [
        { "long": "--input", "short": "-i", "type": "string", "description": "Input data file (JSON); omit for synthetic" },
        { "long": "--backend", "short": "-b", "type": "string", "default": "auto", "description": "Backend (auto, cpu, gpu, npu, tpu)", "choices": ["auto", "cpu", "gpu", "npu", "tpu"] },
        { "long": "--audit", "type": "flag", "description": "Audit mode: log after each op" },
        { "long": "--audit-output", "type": "string", "description": "Audit log file when using --audit" },
        { "long": "--max-workspace-mb", "type": "string", "description": "Max workspace MB (0 = no cap)" }
      ]
    },
    {
      "id": "benchmark",
      "name": "benchmark",
      "description": "Benchmark a COELANOX container",
      "usage": "coelanox benchmark [OPTIONS] --file <FILE>",
      "required": [
        { "long": "--file", "short": "-f", "type": "string", "placeholder": "FILE", "description": "COELANOX file to benchmark" }
      ],
      "optional": [
        { "long": "--iterations", "short": "-i", "type": "string", "default": "100", "description": "Number of iterations" },
        { "long": "--loop-iterations", "type": "string", "description": "Long-run iterations (overrides --iterations)" },
        { "long": "--output", "type": "string", "default": "text", "description": "Output format", "choices": ["text", "json"] },
        { "long": "--max-workspace-mb", "type": "string", "description": "Max workspace MB (0 = no cap)" }
      ]
    },
    {
      "id": "env",
      "name": "env",
      "description": "Show system environment information",
      "usage": "coelanox env",
      "required": [],
      "optional": []
    },
    {
      "id": "debug",
      "name": "debug",
      "description": "Debug a COELANOX container with detailed diagnostics",
      "usage": "coelanox debug [OPTIONS] --file <FILE>",
      "required": [
        { "long": "--file", "short": "-f", "type": "string", "placeholder": "FILE", "description": "COELANOX file to debug" }
      ],
      "optional": [
        { "long": "--input", "short": "-i", "type": "string", "description": "Input data file (JSON)" },
        { "long": "--output", "short": "-o", "type": "string", "default": "debug_output.json", "description": "Debug log output file" },
        { "long": "--gdb", "type": "flag", "description": "Enable GDB-style debugging (requires GDB)" },
        { "long": "--dump-registers", "type": "flag", "description": "Dump register state on crash" },
        { "long": "--trace-limit", "short": "-t", "type": "string", "default": "10", "description": "Max operations to trace before crash" }
      ]
    },
    {
      "id": "extract",
      "name": "extract",
      "description": "Extract runtime-only binary for deployment (same or cross-arch, e.g. ARM)",
      "usage": "coelanox extract [OPTIONS]",
      "required": [],
      "optional": [
        { "long": "--output", "short": "-o", "type": "string", "default": "coelanox-run", "description": "Output path for runtime binary" },
        { "long": "--arm", "type": "flag", "description": "Extract for ARM64 (aarch64)" },
        { "long": "--target", "type": "string", "description": "Target triple (e.g. aarch64-unknown-linux-gnu); overrides --arm" }
      ]
    },
    {
      "id": "help",
      "name": "help",
      "description": "Print help for a subcommand",
      "usage": "coelanox help [SUBCOMMAND]",
      "required": [],
      "optional": [
        { "long": "SUBCOMMAND", "type": "string", "description": "package | validate | verify | info | run | benchmark | env | debug | extract" }
      ]
    }
  ],
  "env_vars": [
    { "name": "COELANOX_MAX_WORKSPACE_MB", "description": "Max workspace in MB (run/benchmark)" },
    { "name": "COELANOX_CLF_PATH", "description": "Path(s) for CLF backend discovery" }
  ]
}
